{
  "name": "interseguro-node-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit && prettier --check src test *.json *.ts",
    "format": "prettier --write src test *.json *.ts"
  },
  "dependencies": {
    "express": "5.2.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.19.15",
    "@types/supertest": "6.0.3",
    "@vitest/coverage-v8": "4.1.11",
    "prettier": "3.8.1",
    "supertest": "7.2.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "vite": "7.3.7"
  }
}
